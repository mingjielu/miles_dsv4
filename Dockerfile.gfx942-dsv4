# gfx942 (MI300X / MI308X / MI325X) image for DeepSeek-V4-Flash FP8 RL with miles.
#
# With this image, `scripts/amd/run_deepseek_v4.py train --mode normal --num-nodes 2 --num-gpus-per-node 8`
# runs the full recipe on 2 x 8 gfx942 GPUs without extra training arguments (see the operations manual).
#
# Self-contained: build it from any directory; no miles checkout is needed as build context.
#   docker build -f Dockerfile.gfx942-dsv4 -t miles-dsv4-gfx942:0926 .
#
# What it bakes in (all pinned; override the refs with build-args):
#   miles     MILES_REPO @ MILES_REF       radixark/miles main 23d41d711 (2026-09-26) + the gfx942 DeepSeek-V4
#                                          PRs (kernels on 64 KiB LDS, FP8 QAT, CPU streaming gradients,
#                                          2-node launcher, transport retry)
#   sglang    SGLANG_REPO @ SGLANG_REF     sglang-miles 571212b636 (2026-09-26) + the gfx942 DeepSeek-V4 fixes
#                                          (FP8/routing numerics, FP8 MoE weight_loader, SwiGLU clamp,
#                                          in-place reload semantics) + sgl-project/sglang#39629
#   Megatron  MEGATRON_REPO @ MEGATRON_REF radixark/Megatron-LM miles-main f148a32b4 (2026-09-24)
#   Megatron-Bridge MEGATRON_BRIDGE_REF    582783a0 (installs on Python 3.10; the current bridge head needs 3.12)
# and rebuilds sgl_kernel's AOT extension from that sglang checkout: the base image's binary was compiled
# from the base's own sglang revision, so AOT kernel fixes on the checkout would otherwise never run.
#
# Kept from the gfx942 variant of miles' docker/Dockerfile.rocm (all reversible with build-args):
#   GPU_ARCHS is exported                    aiter reads the plural name
#   the AMD-internal apt source is disabled  compute-artifactory.amd.com 404s outside AMD
#   WITH_RCCL_TESTS=0, WITH_KUBE_TOOLS=0     not used by training
#   WITH_PREBUILT_FLASH_ATTN=0               the published wheels are gfx950-only
#   nvidia-resiliency-ext is not installed   needs glibc >= 2.39; the base is Ubuntu 22.04 (2.35)
#   two import checks tolerate a GPU-less builder, and only that one failure
#
# /root/miles, /sgl-workspace/sglang and /root/Megatron-LM are git checkouts installed editable, so a
# fix can be cherry-picked into a running container and take effect without reinstalling.

ARG SGLANG_IMAGE_REPO=rocm/sgl-dev
ARG SGLANG_IMAGE_TAG=v0.5.19-rocm700-mi30x-20260908
FROM ${SGLANG_IMAGE_REPO}:${SGLANG_IMAGE_TAG} AS sglang

SHELL ["/bin/bash", "-ceuxo", "pipefail"]

# ======================================== Arguments ============================================
# Off because a training run does not use them and each fails or misbehaves outside AMD's network
# on gfx942. Pass 1 to restore the upstream behaviour.
ARG WITH_RCCL_TESTS=0
ARG WITH_KUBE_TOOLS=0
ARG WITH_PREBUILT_FLASH_ATTN=0

ARG GPU_ARCH=gfx942
# 1 on ROCm 7.2 to bake the ROCr VMM-pause fix; ROCm 7.0 has no such regression, leave 0.
ARG APPLY_ROCR_VMMFIX=0
ARG SGLANG_USE_ROCM700A=0
# The sgl-router wheel here is manylinux_2_34; newer releases need glibc 2.39, which this base lacks.
ARG WHEELS_REPO=XinyuJiangCMU/miles-wheels-rocm
ARG WHEELS_TAG_ROCM=rocm720-gfx950-v0.5.16
ARG MAX_JOBS=128

ARG RCCL_TESTS_REPO=https://github.com/ROCm/rocm-systems.git
ARG RCCL_TESTS_COMMIT=746c7b3c9e78b094389e19499919fdd43a0b6a90
ARG RCCL_TESTS_PATH=projects/rccl-tests

ARG TRANSFORMER_ENGINE_REPO=https://github.com/ROCm/TransformerEngine.git
ARG TRANSFORMER_ENGINE_BRANCH=v2.8_rocm
ARG MOONCAKE_VERSION=0.3.12.post1

ARG TARGETARCH

# ======================================== Setup ================================================
WORKDIR /root/

ENV MAX_JOBS=${MAX_JOBS}

# Build configuration for gfx942.
ENV GPU_ARCH=${GPU_ARCH}
# Plural, and not a duplicate of the three around it: aiter's chip_info.get_gfx_custom_op_core
# reads GPU_ARCHS and only shells out to rocminfo when it is unset. `docker build` passes no
# /dev/kfd, so without this the probe exits non-zero and takes down every import reaching aiter.
ENV GPU_ARCHS=${GPU_ARCH}
ENV PYTORCH_ROCM_ARCH=${GPU_ARCH}
ENV GPU_ARCH_LIST=${GPU_ARCH}
ENV AMDGPU_TARGET=${GPU_ARCH}

# Transformer Engine build knobs for the v2.8_rocm branch.
ENV NVTE_FRAMEWORK=pytorch
ENV NVTE_ROCM_ARCH=${GPU_ARCH}
ENV NVTE_USE_HIPBLASLT=1
ENV NVTE_USE_ROCM=1
ENV CMAKE_PREFIX_PATH=/opt/rocm:/opt/rocm/hip:/usr/local:/usr

# ======================================== Apt dependencies =====================================
# The base carries /etc/apt/sources.list.d/rocm.list pointing at compute-artifactory.amd.com,
# which resolves only inside AMD and 404s elsewhere, failing `apt update` for the whole build.
# ROCm is already installed in the image and nothing below installs from that repo.
RUN find /etc/apt/sources.list.d -name '*.list' -exec \
      sed -i 's|^deb .*compute-artifactory\.amd\.com.*|# &  # unreachable outside AMD|' {} +
RUN apt update
# Install build tools and diagnostics utilities.
RUN apt install -y build-essential cmake dnsutils ethtool git nvtop patch rsync

# Build rccl-tests diagnostics binaries.
RUN if [ "${WITH_RCCL_TESTS}" = "1" ]; then \
      mkdir -p /tmp/rocm-systems && cd /tmp/rocm-systems && git init -q && \
      git remote add origin ${RCCL_TESTS_REPO} && \
      git fetch --depth 1 origin ${RCCL_TESTS_COMMIT} && git checkout -q FETCH_HEAD && \
      make -C ${RCCL_TESTS_PATH} -j$(nproc) \
        HIP_HOME=/opt/rocm NCCL_HOME=/opt/rocm GPU_TARGETS=${GPU_ARCH} && \
      cp ${RCCL_TESTS_PATH}/build/*_perf /usr/local/bin/ && \
      rm -rf /tmp/rocm-systems; \
    else echo "rccl-tests skipped (WITH_RCCL_TESTS=0)"; fi

# ====================================== Python dependencies ====================================
RUN pip install git+https://github.com/ISEEKYAN/mbridge.git@89eb10887887bc74853f89a4de258c0702932a1c --no-deps

# Prebuilt assets from the miles-wheels-rocm release. gfx942 only needs the sgl-router wheel and the
# gateway binary (installed below); they are fetched by URL rather than through the GitHub API, whose
# unauthenticated rate limit a shared egress IP can exhaust. The gfx950-only Transformer Engine and
# flash-attn wheels are listed through the API only when one of them is requested.
ARG TE_USE_WHEEL=0
ARG SGL_ROUTER_WHEEL=sglang_router-0.3.2-cp38-abi3-manylinux_2_34_x86_64.whl
ARG SGL_GATEWAY_TARBALL=sgl-model-gateway-linux-x86_64.tar.gz
RUN mkdir -p /tmp/wheels && cd /tmp/wheels && \
    for a in ${SGL_ROUTER_WHEEL} ${SGL_GATEWAY_TARBALL}; do \
      curl -fsSL --retry 5 --retry-delay 10 -o "$a" "https://github.com/${WHEELS_REPO}/releases/download/${WHEELS_TAG_ROCM}/$a"; \
    done && \
    if [ "${TE_USE_WHEEL}" = "1" ] || [ "${WITH_PREBUILT_FLASH_ATTN}" = "1" ]; then \
      curl -fsSL "https://api.github.com/repos/${WHEELS_REPO}/releases/tags/${WHEELS_TAG_ROCM}" \
      | python3 -c "import sys,json,subprocess,os; w='/tmp/wheels'; [subprocess.run(['curl','-fsSL','-o',os.path.join(w,a['name']),a['browser_download_url']],check=True) for a in json.load(sys.stdin).get('assets',[]) if a['name'].endswith(('.whl','.tar.gz'))]"; \
    fi && \
    ls -lh /tmp/wheels/
# Transformer Engine: the published wheels are gfx950-only, so build it for gfx942.
RUN pip uninstall -y transformer-engine transformer_engine transformer_engine_torch || true; \
    if [ "${TE_USE_WHEEL}" = "1" ]; then \
      pip install /tmp/wheels/transformer_engine-*.whl; \
    else \
      rm -rf /root/TransformerEngine && \
      git clone --recursive --branch ${TRANSFORMER_ENGINE_BRANCH} ${TRANSFORMER_ENGINE_REPO} /root/TransformerEngine && \
      cd /root/TransformerEngine && NVTE_FUSED_ATTN=0 pip install . --no-build-isolation -v; \
    fi
# Every release under WHEELS_REPO is built for gfx950; there is no gfx942 asset. Installing one
# replaces the flash-attn the base already ships -- on rocm/sgl-dev:v0.5.19-rocm700-mi30x that is
# flash_attn 2.8.0.post2, which imports cleanly with its compiled extension.
RUN if [ "${WITH_PREBUILT_FLASH_ATTN}" = "1" ]; then \
      pip install /tmp/wheels/flash_attn-*.whl; \
    else \
      python -c "import flash_attn, flash_attn_2_cuda; print('keeping the base flash_attn', flash_attn.__version__)"; \
    fi

# make install lays down mooncake's native modules but not its pure Python files.
RUN pip install --no-deps --target=/tmp/mc "mooncake-transfer-engine-non-cuda==${MOONCAKE_VERSION}" && \
    cp -n /tmp/mc/mooncake/*.py "$(python3 -c 'import mooncake, os; print(os.path.dirname(mooncake.__file__))')" && \
    rm -rf /tmp/mc

RUN pip install flash-linear-attention==0.5.2

ARG MEGATRON_REPO=https://github.com/radixark/Megatron-LM.git
ARG MEGATRON_REF=f148a32b4385b758b66a77c9c3ad1641f1295d4b
RUN rm -rf /root/Megatron-LM && \
    git clone ${MEGATRON_REPO} /root/Megatron-LM && \
    cd /root/Megatron-LM && \
    git checkout ${MEGATRON_REF} && \
    git submodule update --init --recursive && \
    pip install -e .

# ====================================== sglang =================================================
# `git reset --hard` only restores tracked files. The base image builds sglang's AOT kernels inside this
# checkout, and torch's CUDAExtension hipifies in place, so the tree also carries generated HIP sources
# as untracked files; the checkout below aborts as soon as one of them sits where the new revision
# tracks a real file, so drop them first. Keep this off ignored files (-x): those include the compiled
# rust extension and _version.py that the editable sglang install in this image depends on.
ARG SGLANG_REPO=https://github.com/xiaohong42/sglang.git
ARG SGLANG_REF=gfx942-dsv4-0927
RUN cd /sgl-workspace/sglang && \
    git reset --hard && \
    git clean -fd && \
    git fetch ${SGLANG_REPO} ${SGLANG_REF} && \
    git checkout FETCH_HEAD && \
    pip install -e "python[all_hip]" --no-deps

# The editable install above only reinstalls the Python package; sgl_kernel's AOT extension is still
# the base image's binary, compiled from the base's own sglang revision. Rebuild it from this checkout.
# The build hipifies in place and the .cu sources include ../../../jit/include, so it runs in a copy of
# kernels/ that keeps that layout. easy-install.pth lists eggs in install order and the first one wins,
# so the base's egg is removed first.
# 1: rebuild sgl_kernel's AOT extension from the sglang checkout (required for the FP8 encoder fix).
ARG REBUILD_SGL_KERNEL=1
RUN if [ "${REBUILD_SGL_KERNEL}" = "1" ]; then \
      sp="$(python -c 'import site; print(site.getsitepackages()[0])')" && \
      (pip uninstall -y sglang-kernel || true) && \
      if [ -f "$sp/easy-install.pth" ]; then sed -i '\#^\./sglang_kernel-.*\.egg$#d' "$sp/easy-install.pth"; fi && \
      rm -rf "$sp"/sglang_kernel-*.egg && \
      mkdir -p /tmp/sgl-aot/python/sglang && \
      cp -r /sgl-workspace/sglang/python/sglang/kernels /tmp/sgl-aot/python/sglang/ && \
      cd /tmp/sgl-aot/python/sglang/kernels/aot && \
      rm -rf build dist ./*.egg-info && cp pyproject_rocm.toml pyproject.toml && \
      AMDGPU_TARGET=${GPU_ARCH} python setup_rocm.py install && \
      cd / && rm -rf /tmp/sgl-aot; \
    fi

# SGLang is installed without dependencies, but its Inkling multimodal processor imports numba.
RUN pip install "numba==0.65.1"

# aiter resolves the LIVE architecture in chip_info.get_gfx_runtime, which its own docstring
# describes as "always via rocminfo, ignores GPU_ARCHS" -- so unlike the build-time path there is
# no environment override, and on a builder without /dev/kfd this import cannot succeed. Accept
# that one failure and nothing else: any other ImportError still fails the build.
RUN out=$(python -c "import sglang; import sgl_kernel; print('SGLang + sgl_kernel: OK', sgl_kernel.__file__)" 2>&1) || true; \
    echo "$out"; \
    echo "$out" | grep -q 'SGLang + sgl_kernel: OK' \
      || echo "$out" | grep -q 'Get GPU arch from rocminfo failed' \
      || { echo "unexpected failure, not the GPU-less rocminfo probe"; exit 1; }

RUN pip install git+https://github.com/fzyzcjy/torch_memory_saver.git@f05a8754daf68238d54e4cf31cb3ba866684bbaf --no-cache-dir --force-reinstall

# Fix the ROCm 7.2 ROCr VMM-pause leak.
RUN if [ "$APPLY_ROCR_VMMFIX" = "1" ]; then \
      asset="libhsa-runtime64.so.1.18.70200.vmmfix"; \
      curl -fsSL -o "/tmp/$asset" "https://github.com/${WHEELS_REPO}/releases/download/${WHEELS_TAG_ROCM}/$asset"; \
      dst="$(readlink -f /opt/rocm/lib/libhsa-runtime64.so.1)"; \
      case "$dst" in \
        *.1.18.70200) ;; \
        *) echo "[vmmfix] ROCr soname mismatch: $dst (expected .1.18.70200 = ROCm 7.2.0); rebuild the .so" >&2; exit 1 ;; \
      esac; \
      cp -a "$dst" /opt/libhsa-runtime64.so.stock-prevmmfix.bak && \
      install -m0644 "/tmp/$asset" "$dst" && rm -f "/tmp/$asset" && \
      echo "[vmmfix] installed patched ROCr at $dst"; \
    else \
      echo "[vmmfix] skipped (APPLY_ROCR_VMMFIX=$APPLY_ROCR_VMMFIX; ROCm 7.0 has no VMM-pause regression)"; \
    fi
# The bridge branch head now requires Python >= 3.12 and this base is 3.10; 582783a0 is what the
# validated gfx942 container runs.
ARG MEGATRON_BRIDGE_REF=582783a05442245647239e4c5e7d733d7f0e00ea
RUN pip install git+https://github.com/radixark/Megatron-Bridge.git@${MEGATRON_BRIDGE_REF} --no-deps --no-build-isolation
RUN pip install megatron-energon --no-deps
RUN pip install multi-storage-client --no-deps

# Megatron post_training and Megatron-Bridge hard-import modelopt.
RUN pip install "nvidia-modelopt[torch]>=0.37.0" --no-build-isolation
# modelopt pulls setuptools up to 82, which drops pkg_resources and breaks deps that
# still import it; re-pin to the base image's setuptools.
RUN pip install "setuptools==79.0.1"

# ====================================== miles source ===========================================
# The patches and requirements below come from this revision, so the image never mixes files from a
# build context with a different miles checkout. Cloned after the slow builds above, so changing
# MILES_REF only rebuilds what follows.
ARG MILES_REPO=https://github.com/xiaohong42/miles.git
ARG MILES_REF=gfx942-dsv4-0926
RUN git clone ${MILES_REPO} /root/miles && \
    cd /root/miles && \
    git checkout ${MILES_REF} && \
    mkdir -p /tmp/amd_patch && \
    cp docker/amd_patch/latest/tile_kernels.patch docker/amd_patch/latest/tilelang_hip_fp8.patch /tmp/amd_patch/ && \
    cp requirements.txt /tmp/requirements.txt && \
    cp docker/install-kube-tools.sh /tmp/install-kube-tools.sh

# Enable deepseek-ai/TileKernels on ROCm for mHC and FP8 QAT cast-back.
# These temporary build-time patches make tile_kernels import lazy, remove CUDA/Hopper-only PDL from mhc_post,
# and fix TileLang's HIP fp8->float conversion to use ROCm device intrinsics instead of the SDK host-only operator.
RUN pip install --no-deps tile_kernels==1.0.0 && \
    patch -p1 -d /opt/venv/lib/python3.10/site-packages < /tmp/amd_patch/tile_kernels.patch && \
    patch -p1 -d /opt/tilelang/src/tl_templates/hip < /tmp/amd_patch/tilelang_hip_fp8.patch

RUN rm -rf /usr/lib/python3/dist-packages/jwt /usr/lib/python3/dist-packages/PyJWT* && \
    sed -i '/nvidia-resiliency-ext/d' /tmp/requirements.txt && \
    pip install -r /tmp/requirements.txt

# Pin the CLI stack (typer/click) for huggingface_hub / Ray compatibility.
RUN pip install "typer==0.25.1" "click==8.2.1"

# Pin numpy 1.x for Megatron compatibility.
RUN pip install "numpy<2"

# TARGETARCH is empty unless the build goes through buildx, which makes the download URLs
# malformed rather than absent.
RUN if [ "${WITH_KUBE_TOOLS}" = "1" ]; then \
      bash /tmp/install-kube-tools.sh "${TARGETARCH}"; \
    else echo "kube tools skipped (WITH_KUBE_TOOLS=0)"; fi; \
    rm -f /tmp/install-kube-tools.sh

# ====================================== Install main package ===================================

RUN cd /root/miles && pip install -e . --no-deps

# See the sglang import check above: only the GPU-less rocminfo probe may fail here.
RUN out=$(python -c "import miles.backends.fsdp_utils; import miles.backends.megatron_utils; print('miles backends: OK')" 2>&1) || true; \
    echo "$out"; \
    echo "$out" | grep -q 'miles backends: OK' \
      || echo "$out" | grep -q 'Get GPU arch from rocminfo failed' \
      || { echo "unexpected failure, not the GPU-less rocminfo probe"; exit 1; }

# ====================================== Install sgl-model-gateway ============================================
# SGL_ROUTER_USE_WHEELS=1 (default): prebuilt sgl-router wheel + gateway binary; 0: build from source.
ARG SGL_ROUTER_USE_WHEELS=1
ARG SGL_ROUTER_REPO=https://github.com/radixark/sgl-router-for-miles.git
ARG SGL_ROUTER_BRANCH=main

RUN --mount=type=cache,target=/root/.cache/pip \
    set -eux; \
    if [ "${SGL_ROUTER_USE_WHEELS}" = "1" ]; then \
      pip install --force-reinstall --no-deps /tmp/wheels/sglang_router-*.whl && \
      tar xzf /tmp/wheels/sgl-model-gateway-linux-*.tar.gz -C /usr/local/bin/ && \
      chmod +x /usr/local/bin/sgl-model-gateway; \
    else \
      export PATH="/root/.cargo/bin:${PATH}" && \
      { command -v cargo >/dev/null 2>&1 || curl --proto '=https' --tlsv1.2 --retry 3 --retry-delay 2 -sSf https://sh.rustup.rs | sh -s -- -y; } && \
      python3 -m pip install maturin && \
      git clone --branch "${SGL_ROUTER_BRANCH}" --depth 1 "${SGL_ROUTER_REPO}" /build/sgl-model-gateway && \
      ( cd /build/sgl-model-gateway/bindings/python && ulimit -n 65536 && maturin build --release --features vendored-openssl --out /build/gateway_wheels ) && \
      ( cd /build/sgl-model-gateway && cargo build --release --bin sgl-model-gateway --features vendored-openssl ) && \
      cp /build/sgl-model-gateway/target/release/sgl-model-gateway /usr/local/bin/sgl-model-gateway && \
      chmod +x /usr/local/bin/sgl-model-gateway && \
      pip install --force-reinstall --no-deps /build/gateway_wheels/sglang_router-*.whl && \
      rm -rf /root/.cargo /root/.rustup /build/sgl-model-gateway /build/gateway_wheels; \
    fi

RUN rm -rf /tmp/wheels

ARG SGLANG_IMAGE_REPO
ARG SGLANG_IMAGE_TAG
# What this image was built from, for support requests.
RUN { \
      echo "miles    $(git -C /root/miles rev-parse HEAD)  (${MILES_REPO} @ ${MILES_REF})"; \
      echo "sglang   $(git -C /sgl-workspace/sglang rev-parse HEAD)  (${SGLANG_REPO} @ ${SGLANG_REF})"; \
      echo "megatron $(git -C /root/Megatron-LM rev-parse HEAD)  (${MEGATRON_REPO})"; \
      echo "megatron-bridge ${MEGATRON_BRIDGE_REF}"; \
      echo "base     ${SGLANG_IMAGE_REPO}:${SGLANG_IMAGE_TAG}"; \
    } > /root/VERSIONS.txt && cat /root/VERSIONS.txt

# ====================================== Runtime knobs ==========================================

# Runtime knobs consumed by the current SGLang/PyTorch stack. The gfx942 launcher overrides the ones
# the DeepSeek-V4 recipe needs (CPU affinity, inductor autotune, HW queues) per run.
ENV MILES_HARDWARE_PLATFORM=rocm
ENV HIP_FORCE_DEV_KERNARG=1
ENV HSA_ENABLE_IPC_MODE_LEGACY=1
ENV HSA_NO_SCRATCH_RECLAIM=1
ENV SGLANG_USE_AITER=1
ENV SGLANG_ALLOW_OVERWRITE_LONGER_CONTEXT_LEN=1
ENV SGLANG_MOE_PADDING=1
ENV SGLANG_SET_CPU_AFFINITY=1
ENV SGLANG_ROCM_FUSED_DECODE_MLA=1
ENV SGLANG_USE_ROCM700A=${SGLANG_USE_ROCM700A}
ENV NCCL_MIN_NCHANNELS=112
ENV TORCHINDUCTOR_MAX_AUTOTUNE=1
ENV TORCHINDUCTOR_MAX_AUTOTUNE_POINTWISE=1
# Keep GPUs visible to Ray num_gpus=0 coordinators so Megatron device checks do not crash.
ENV RAY_ACCEL_ENV_VAR_OVERRIDE_ON_ZERO=0

RUN rm -rf /root/.cache/pip /root/TransformerEngine /tmp/amd_patch

WORKDIR /root/

CMD ["/usr/bin/bash"]
